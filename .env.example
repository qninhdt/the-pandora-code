OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_IMAGE_MODEL=


# tvoiceai.com TTS (scripts/tvoiceai-tts.mjs)
TVOICEAI_USER=
TVOICEAI_PASS=


# Cloudflare R2 (S3 API) for static images + chapter audio (scripts/r2-sync.mjs).
# Create an R2 API token with Object Read & Write; the endpoint is derived from
# R2_ACCOUNT_ID unless R2_ENDPOINT overrides it.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=the-pandora-code
# Public origin of the bucket; mirror it into apps/web NEXT_PUBLIC_STATIC_BASE.
R2_PUBLIC_BASE=
