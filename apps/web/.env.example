# Canonical site origin for sitemap, RSS, OpenGraph, and canonical/hreflang URLs.
# Falls back to http://localhost:3000 in dev. Set this on Vercel to the prod URL.
# NEXT_PUBLIC_SITE_URL=https://thepandora.code
# Static images and audio origin. Leave empty for local public/ assets.
# NEXT_PUBLIC_STATIC_BASE=https://cdn.example.com
